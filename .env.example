# Change Order Desk — environment contract. Copy to .env.local (gitignored). Never commit real values.
# Frontend (Vite)
VITE_CONVEX_URL=              # set automatically by `npx convex dev`; static-hosting deploy injects the prod URL

# Convex deployment env (set with `npx convex env set NAME value`, never in this file):
#   PROVIDER_MODE=mock|live            # mock = deterministic fixtures for all three providers (default when unset)
#   OPENAI_API_KEY=                    # OpenAI platform key (Responses API); required only when PROVIDER_MODE=live
#   OPENAI_MODEL=gpt-5.6-terra         # model id recorded in hackathon.md
#   FIRECRAWL_API_KEY=                 # Firecrawl API key (component); required at deploy time — set a placeholder in mock mode
#   FIRECRAWL_WEBHOOK_SECRET=          # optional, for Firecrawl crawl webhooks
#   AGENTMAIL_API_KEY=                 # AgentMail API key (component)
#   AGENTMAIL_WEBHOOK_SECRET=          # Svix signing secret for /agentmail/webhook
#   AGENTMAIL_DEFAULT_DOMAIN=agentmail.to
#   DEMO_INBOUND_SECRET=               # shared secret for the /demo/inbound fixture route (dev + demo only)
