# Storefront Desk (Provisional) — environment contract.
# Copy to .env.local (gitignored). Never commit real values or secrets.

# Frontend (Vite)
VITE_CONVEX_URL=                          # set automatically by `npx convex dev`; static-hosting deploy injects the prod URL

# Convex deployment environment variables (set with `npx convex env set NAME value`, never in tracked files):
#   PROVIDER_MODE=fixture|live            # fixture = deterministic offline mocks for all 4 sponsors (default when unset); live = real APIs
#   OPENAI_API_KEY=                       # OpenAI API key (structured outputs via @convex-dev/agent); required only when PROVIDER_MODE=live
#   OPENAI_MODEL=gpt-5.6-terra            # OpenAI model ID recorded in hackathon.md
#   GOOGLE_PLACES_API_KEY=                # Google Places API key (Text Search & Details) for official business discovery
#   FIRECRAWL_API_KEY=                    # Firecrawl API key (@firecrawl/firecrawl-convex component); required when live
#   FIRECRAWL_WEBHOOK_SECRET=             # optional, for Firecrawl webhook verification
#   AGENTMAIL_API_KEY=                    # AgentMail API key (@agentmail/convex component)
#   AGENTMAIL_INBOX_ID=                   # Operator-owned AgentMail inbox ID used for all outbound sends
#   AGENTMAIL_WEBHOOK_SECRET=             # Svix signing secret for /agentmail/webhook
#   AGENTMAIL_DEFAULT_DOMAIN=agentmail.to
#   DEMO_INBOUND_SECRET=                  # shared secret for the fixture test route
